<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{A1111111-1111-1111-1111-111111111111}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>FrostyCLI</RootNamespace>
    <AssemblyName>FrostyCLI</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <OutputPath>bin\x64\Release\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>false</Optimize>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FrostySdk">
      <HintPath>..\lib\FrostySdk.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="FrostyHash">
      <HintPath>..\lib\FrostyHash.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- ProjectReference (not HintPath) so MSBuild builds these first and copies their FRESH
         output into the exe. With a bare HintPath the sln could build the exe before Pipeline
         finished and copy a stale DLL, silently dropping newly-added pipeline ops. -->
    <ProjectReference Include="..\FrostyCLI.Core\FrostyCLI.Core.csproj">
      <Project>{A2222222-2222-2222-2222-222222222222}</Project>
      <Name>FrostyCLI.Core</Name>
    </ProjectReference>
    <ProjectReference Include="..\FrostyCLI.Commands\FrostyCLI.Commands.csproj">
      <Project>{A3333333-3333-3333-3333-333333333333}</Project>
      <Name>FrostyCLI.Commands</Name>
    </ProjectReference>
    <ProjectReference Include="..\FrostyCLI.Pipeline\FrostyCLI.Pipeline.csproj">
      <Project>{A4444444-4444-4444-4444-444444444444}</Project>
      <Name>FrostyCLI.Pipeline</Name>
    </ProjectReference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Runtime.InteropServices" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
    <Content Include="..\lib\libfbxsdk.dll">
      <Link>thirdparty\libfbxsdk.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\lib\libzstd.dll">
      <Link>thirdparty\libzstd.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- SWBF1/SWBF2 (and other non-FIFA profiles) bind zstd by this exact versioned
         name via ProfilesLibrary...GetZStdDllName() -> "thirdparty/libzstd.1.1.5.dll".
         Without it, ZStd.Bind() silently fails and every asset decompress throws NRE. -->
    <Content Include="..\lib\libzstd.1.1.5.dll">
      <Link>thirdparty\libzstd.1.1.5.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\lib\zlibwapi.dll">
      <Link>thirdparty\zlibwapi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\lib\liblz4.so.1.8.0.dll">
      <Link>thirdparty\liblz4.so.1.8.0.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\lib\thirdparty\dxtex.dll">
      <Link>thirdparty\dxtex.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- EALayer3 sound encoder (optional; the compressed `import sound` path also needs ffmpeg.exe). -->
    <Content Include="..\lib\thirdparty\ealayer3_encode.exe">
      <Link>thirdparty\ealayer3_encode.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\lib\thirdparty\ealayer3_encode.dll">
      <Link>thirdparty\ealayer3_encode.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\lib\thirdparty\libmpg123-0.dll">
      <Link>thirdparty\libmpg123-0.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- ffmpeg.exe is the user-supplied half of the EALayer3 encode chain (too large to vendor; not
         in git). If you drop it in lib/thirdparty it ships next to the exe; otherwise the encoder also
         finds it on PATH or at C:\ffmpeg\bin. Conditional so the build works whether or not it's there. -->
    <Content Include="..\lib\thirdparty\ffmpeg.exe" Condition="Exists('..\lib\thirdparty\ffmpeg.exe')">
      <Link>thirdparty\ffmpeg.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\lib\Profiles\StarWarsSDK.dll">
      <Link>Profiles\StarWarsSDK.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- AssetDefinition adapters: also copy into Adapters\ so the standalone exe (and the `run`
         pipeline, which uses the default adapters dir) discovers them for export/import. -->
    <Content Include="..\FrostyCLI.Adapters.Texture\bin\x64\Release\FrostyCLI.Adapters.Texture.dll">
      <Link>Adapters\FrostyCLI.Adapters.Texture.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\FrostyCLI.Adapters.Mesh\bin\x64\Release\FrostyCLI.Adapters.Mesh.dll">
      <Link>Adapters\FrostyCLI.Adapters.Mesh.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\lib\Profiles\StarWarsIISDK.dll">
      <Link>Profiles\StarWarsIISDK.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="CommandBus.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Port-name vocabulary for reverse-resolving connection port ids (Core/PortNames.cs).
         Shipped beside the exe so `connection ls` prints names out of the box. -->
    <None Include="..\data\portnames.txt" Link="portnames.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- SWBF 2015 -> BFII physics material words (HavokPhysicsResource.ConvertFromSwbf1), from 170 DICE prop
         pairs: port import converts a 2015 package's physics with it (raw 2015 words = walk-through). -->
    <None Include="..\data\swbf1_material_wordmap.json" Link="swbf1_material_wordmap.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
